meta {
  name: Sign In - Invalid Credentials
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/api/auth/sign-in/email
  body: json
  auth: inherit
}

body:json {
  {
    "email": "nonexistent@example.com",
    "password": "wrongpassword123"
  }
}

tests {
  test("should return 401 for invalid credentials", function () {
    expect(res.getStatus()).to.be.oneOf([401, 400]);
  });
  
  test("should not return user data", function () {
    expect(res.body.user).to.not.exist;
  });
}

settings {
  encodeUrl: true
}
