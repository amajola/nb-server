meta {
  name: Sign Up
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/auth/signup
  body: json
  auth: inherit
}

body:json {
  {
    "name":"{{username}}",
    "email":"{{email}}",
    "password":"{{password}}"
  }
}

body:multipart-form {
  : 
}

script:pre-request {
  
  const firstName = bru.interpolate('{{$randomFirstName}}');
  const password = bru.interpolate('{{$randomPassword}}');
  const email = bru.interpolate('{{$randomEmail}}');
  
  bru.setEnvVar("username", firstName)
  bru.setEnvVar("password", password)
  bru.setEnvVar("email", email)
  
  
}

script:post-response {
  bru.setEnvVar("token", res.body.response.token)
  req.setHeaders(res.body.headers);
  bru.setEnvVar("cookies", res.body.headers["set-cookie"])
  
  bru.setEnvVar("auth_token", res.body.response.token);
  bru.setEnvVar("user_id", res.body.response.user.id);
  bru.setEnvVar("user_email", res.body.response.user.email);
  bru.setEnvVar("user_name", res.body.response.user.name);
}

tests {
  // ---------------------------
  // 1. Check status code
  // ---------------------------
  test("status should be 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  
  // ---------------------------
  // 2. Validate response body
  // ---------------------------
  test("response should have token and user info", function () {
    const body = res.body.response;
  
    expect(body).to.exist;
    expect(body.token).to.exist;
    expect(body.user).to.exist;
  
    // Validate user fields match request variables
    expect(body.user.email).to.equal(bru.interpolate("{{email}}").toLowerCase());
    expect(body.user.name).to.equal(bru.interpolate("{{username}}"));
  });
  
  // ---------------------------
  // 3. Extract and save cookies
  // ---------------------------
  const cookies = res.headers["set-cookie"];
  if (cookies && cookies.length > 0) {
    cookies.forEach((cookie) => {
      const [pair] = cookie.split(";");
      const [key, value] = pair.split("=");
      if (key && value) {
        bru.setEnvVar(key.trim(), value.trim());
      }
    });
  }
}

settings {
  encodeUrl: true
}
