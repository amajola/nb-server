meta {
  name: Create - Unauthorized
  type: http
  seq: 3
}

post {
  url: {{base_url}}/posts/create
  body: json
  auth: inherit
}

body:json {
  {
    "header": "Test header",
    "content": "Test content"
  }
}

tests {
  test("should return 401 without authentication", function () {
    expect(res.getStatus()).to.equal(401);
  });
  
  test("should return error message", function () {
    expect(res.body).to.exist;
    expect(res.body.error).to.exist;
  });
}

settings {
  encodeUrl: false
}
