{
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "lib": ["deno.ns", "ES2023", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true
  },
  "imports": {
    "@hono/zod-validator": "npm:@hono/zod-validator@^0.4.1",
    "@std/dotenv": "jsr:@std/dotenv@^0.225.5",
    "@trpc/client": "npm:@trpc/client@^11.0.0-rc.377",
    "@trpc/server": "npm:@trpc/server@^11.0.0-rc.377",
    "better-auth": "npm:better-auth@^1.3.26",
    "better-auth/": "npm:/better-auth@^1.3.26/",
    "drizzle-orm": "npm:drizzle-orm@^0.39.0",
    "drizzle-orm/": "npm:/drizzle-orm@^0.39.0/",
    "drizzle-zod": "npm:drizzle-zod@^0.5.1",
    "faker": "npm:faker@^6.6.6",
    "generate": "npm:generate@^0.14.0",
    "hono": "npm:hono@^4.6.14",
    "hono/": "npm:/hono@^4.6.14/",
    "pg": "npm:pg@^8.11.5",
    "zod": "npm:zod@^3.24.1",
    "@faker-js/faker": "npm:@faker-js/faker@^9.3.0",
    "@types/pg": "npm:@types/pg@^8.11.10",
    "drizzle-kit": "npm:drizzle-kit@^0.30.1",
    "@better-auth/cli": "npm:@better-auth/cli@^1.3.26",
    "postgres": "npm:postgres@^3.4.5"
  },
  "tasks": {
    "dev": "deno serve --watch --allow-all src/index.ts",
    "start": "deno serve --allow-all src/index.ts",
    "generate": "deno run --allow-all npm:drizzle-kit generate",
    "migrate": "deno run --allow-all npm:drizzle-kit migrate",
    "auth:generate": "deno run --allow-all npm:@better-auth/cli generate",
    "auth:migrate": "deno run --allow-all npm:@better-auth/cli migrate",
    "test": "deno test --allow-all --parallel",
    "test:coverage": "deno test --allow-all --parallel --coverage=coverage",
    "coverage:report": "deno coverage coverage --lcov --output=coverage/lcov.info && deno coverage coverage",
    "coverage:html": "deno coverage coverage --html",
    "test:watch": "deno test --allow-all --watch",
    "check": "deno check src/**/*.ts",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "docker:build": "bash scripts/docker-compose.sh build",
    "docker:start": "bash scripts/docker-compose.sh start",
    "docker:stop": "bash scripts/docker-compose.sh stop",
    "docker:restart": "bash scripts/docker-compose.sh restart",
    "docker:logs": "bash scripts/docker-compose.sh logs",
    "docker:logs:app": "bash scripts/docker-compose.sh logs app",
    "docker:logs:db": "bash scripts/docker-compose.sh logs db",
    "docker:status": "bash scripts/docker-compose.sh status",
    "docker:clean": "bash scripts/docker-compose.sh clean",
    "docker:rebuild": "bash scripts/docker-compose.sh rebuild",
    "podman:build": "bash scripts/run-podman.sh build",
    "podman:start": "bash scripts/run-podman.sh start",
    "podman:stop": "bash scripts/run-podman.sh stop",
    "podman:restart": "bash scripts/run-podman.sh restart",
    "podman:logs": "bash scripts/run-podman.sh logs",
    "podman:logs:app": "bash scripts/run-podman.sh logs app",
    "podman:logs:db": "bash scripts/run-podman.sh logs db",
    "podman:status": "bash scripts/run-podman.sh status",
    "podman:clean": "bash scripts/run-podman.sh clean"
  },
  "exclude": [
    "node_modules/",
    "Docker/",
    "bruno/",
    "drizzle/"
  ],
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false,
    "proseWrap": "preserve",
    "include": ["src/"]
  },
  "lint": {
    "include": ["src/"],
    "rules": {
      "tags": ["recommended"]
    }
  }
}
